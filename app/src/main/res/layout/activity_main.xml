<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Health Connector"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Health Connect + совместимые часы и браслеты + импорт питания FatSecret"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Работает с источниками, которые передают данные в Health Connect: Mi Fitness, Samsung Health, Garmin Connect, Google Health и другими совместимыми приложениями."
            android:textSize="12sp" />

        <EditText
            android:id="@+id/endpoint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="URL Google Apps Script /exec"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Секретный токен"
            android:inputType="textPassword" />

        <EditText
            android:id="@+id/days"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Количество дней"
            android:inputType="number"
            android:text="7" />

        <Button
            android:id="@+id/exportConfig"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Сохранить настройки в файл" />

        <Button
            android:id="@+id/importConfig"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Восстановить настройки из файла" />

        <Button
            android:id="@+id/permissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Выдать разрешения Health Connect" />

        <Button
            android:id="@+id/connectWearable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Подключить часы или браслет" />

        <Button
            android:id="@+id/sync"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Синхронизировать данные" />

        <Button
            android:id="@+id/importCsv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Выбрать CSV FatSecret и отправить" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Файл настроек содержит секретный токен. Храни его в закрытой папке."
            android:textSize="12sp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Готово к настройке"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
